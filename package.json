{
  "name": "xmonkey",
  "productName": "xMonkey",
  "version": "0.2.0",
  "private": true,
  "description": "xMonkey — a model-agnostic coding agent. Bring your own model; local models first-class.",
  "main": "app/main.mjs",
  "type": "module",
  "bin": {
    "xmonkey": "./bin/xmonkey.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node bin/xmonkey.mjs",
    "test": "node --test test/",
    "test:local": "node --test test/e2e-local.test.mjs",
    "app:build": "node tools/build-app.mjs",
    "app:dist": "node tools/build-app.mjs --dist"
  },
  "devDependencies": {
    "electron": "^40.0.0"
  },
  "license": "MIT",
  "build": {
    "appId": "com.xmonkey.app",
    "productName": "xMonkey",
    "files": [
      "app/**/*",
      "src/**/*",
      "bin/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dir"],
      "icon": "app/icon.icns"
    }
  }
}
